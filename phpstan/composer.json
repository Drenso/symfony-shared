{
  "name": "drenso/symfony-shared-phpstan",
  "description": "This package contains commonly shared phpstan extensions between our projects.",
  "keywords": [
    "phpstan",
    "shared",
    "drenso"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Bob van de Vijver",
      "email": "bob@drenso.nl"
    },
    {
      "name": "Tobias Feijten",
      "email": "tobias@drenso.nl"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.3",
    "nikic/php-parser": "^5",
    "phpstan/phpstan": "^2.2",
    "symfony/doctrine-bridge": "~6 || ~7 || ~8",
    "symfony/uid": "~6 || ~7 || ~8"
  },
  "require-dev": {
    "doctrine/orm": "^3",
    "doctrine/dbal": "^4"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Drenso\\Shared\\PhpStan\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "6.x-dev"
    }
  }
}
