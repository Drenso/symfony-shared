{
  "symbol-whitelist" : [
    "null", "true", "false",
    "static", "self", "parent",
    "array", "string", "int", "float", "bool", "iterable", "callable", "void", "object", "mixed",
    "trigger_deprecation",
    "PhpParser\\Node",
    "PhpParser\\Node\\Name\\FullyQualified",
    "PhpParser\\Node\\Stmt\\Class_",
    "PHPStan\\Reflection\\ClassReflection",
    "Rector\\Contract\\Rector\\ConfigurableRectorInterface",
    "Rector\\PHPStan\\ScopeFetcher",
    "Rector\\Rector\\AbstractRector",
    "Symplify\\RuleDocGenerator\\ValueObject\\CodeSample\\ConfiguredCodeSample",
    "Symplify\\RuleDocGenerator\\ValueObject\\RuleDefinition"
  ],
  "php-core-extensions" : [
    "Core",
    "date",
    "pcre",
    "Phar",
    "Reflection",
    "SPL",
    "standard",
    "decimal"
  ],
  "scan-files" : []
}
