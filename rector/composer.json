{
  "name": "drenso/symfony-shared-rector",
  "description": "This package contains commonly shared rector extensions between our projects.",
  "keywords": [
    "rector",
    "shared",
    "drenso"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Bob van de Vijver",
      "email": "bob@drenso.nl"
    },
    {
      "name": "Tobias Feijten",
      "email": "tobias@drenso.nl"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.3",
    "rector/rector": "^2.6",
    "webmozart/assert": "^2.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.18",
    "phpstan/phpstan": "2.2.8",
    "phpunit/phpunit": "13.2.4",
    "rector/rector": "2.6.1"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Drenso\\Shared\\Rector\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drenso\\Shared\\Rector\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "6.x-dev"
    }
  }
}
