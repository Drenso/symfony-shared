{
  "name": "drenso/symfony-shared-phpunit",
  "description": "This package contains commonly shared phpunit extensions between our projects.",
  "keywords": [
    "phpunit",
    "shared",
    "drenso"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Bob van de Vijver",
      "email": "bob@drenso.nl"
    },
    {
      "name": "Tobias Feijten",
      "email": "tobias@drenso.nl"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php" : "^8.3",
    "sebastian/comparator": "^8"
  },
  "require-dev": {
    "php-decimal/php-decimal": "^1.1",
    "friendsofphp/php-cs-fixer": "3.95.18",
    "phpstan/phpstan": "2.2.8",
    "rector/rector": "2.6.1"
  },
  "suggest": {
    "php-decimal/php-decimal": "Needed to use the Decimal comparator"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Drenso\\Shared\\PhpUnit\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "8.x-dev"
    }
  }
}
